```gitignore
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/

# Gradle
.gradle/
build/
**/build/
gradle-app.setting
.gradletasknamecache

# Minecraft / NeoForge runtime
run/
runs/

# Compiled files / packages
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Gradle Wrapper must be committed
!gradle-wrapper.jar

# Logs / crash dumps
*.log
hs_err_pid*
*.stackdump

# Temporary files
*~
.fuse_hidden*
.nfs*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
.directory
.Trash-*
```
